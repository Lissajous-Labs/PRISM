#!/bin/sh
set -eu
root=$(git rev-parse --show-toplevel)
cmake -S "$root" -B "$root/build/hooks" -DBUILD_TESTING=OFF
cmake --build "$root/build/hooks" --target prism_check_comments
snapshot=$(mktemp -d)
trap 'rm -rf "$snapshot"' EXIT HUP INT TERM
git checkout-index --all --prefix="$snapshot/"
"$root/build/hooks/prism_check_comments" "$snapshot"
formatter=${CLANG_FORMAT:-$(command -v clang-format || true)}
if [ -n "$formatter" ]; then
    cd "$snapshot"
    git -C "$root" ls-files -- '*.h' '*.hpp' '*.cpp' '*.mm' | xargs "$formatter" --dry-run --Werror
fi
