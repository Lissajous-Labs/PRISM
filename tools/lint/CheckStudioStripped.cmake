string(REPLACE "|" ";" libraries "${LIBRARIES}")
find_program(NM_TOOL nm REQUIRED)
foreach(library IN LISTS libraries)
    execute_process(COMMAND "${NM_TOOL}" -C "${library}" OUTPUT_VARIABLE symbols ERROR_QUIET)
    string(FIND "${symbols}" "prism::studio" found)
    if(NOT found EQUAL -1)
        message(FATAL_ERROR "Studio symbols linked into ${library}")
    endif()
endforeach()
message(STATUS "Studio stripped from ${libraries}")
