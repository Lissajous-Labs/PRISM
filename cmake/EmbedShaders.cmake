string(REPLACE "|" ";" sources "${SHADER_SOURCES}")
set(parts "")
set(total 0)
foreach(source IN LISTS sources)
    file(READ "${source}" text)
    string(LENGTH "${text}" length)
    math(EXPR total "${total} + ${length} + 1")
    string(APPEND parts "R\"prism(${text}\n)prism\",\n")
endforeach()
file(WRITE "${OUTPUT}.tmp"
    "#include \"render/ShaderLibrary.h\"\n#include <array>\n\nnamespace prism::render {\nstd::string_view metalShaderSource() noexcept {\n    static constexpr std::string_view parts[] = {${parts}};\n    static constexpr auto source = [] {\n        std::array<char, ${total}> result{};\n        std::size_t offset = 0;\n        for (auto part : parts) {\n            for (char c : part) {\n                result[offset++] = c;\n            }\n        }\n        return result;\n    }();\n    return {source.data(), source.size()};\n}\n}\n")
file(COPY_FILE "${OUTPUT}.tmp" "${OUTPUT}" ONLY_IF_DIFFERENT)
