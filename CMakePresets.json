{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "headless",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": "ON",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "sanitized",
      "inherits": "headless",
      "cacheVariables": {
        "PRISM_SANITIZE": "ON"
      }
    },
    {
      "name": "realtime",
      "inherits": "headless",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "PRISM_REALTIME_SANITIZE": "ON"
      }
    },
    {
      "name": "release",
      "inherits": "headless",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "PRISM_ENABLE_STUDIO": "OFF"
      }
    },
    {
      "name": "bench",
      "inherits": "release",
      "cacheVariables": {
        "PRISM_BUILD_BENCH": "ON"
      }
    },
    {
      "name": "plugin",
      "inherits": "release"
    }
  ],
  "buildPresets": [
    {
      "name": "headless",
      "configurePreset": "headless"
    },
    {
      "name": "sanitized",
      "configurePreset": "sanitized"
    },
    {
      "name": "realtime",
      "configurePreset": "realtime"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "bench",
      "configurePreset": "bench"
    },
    {
      "name": "plugin",
      "configurePreset": "plugin"
    }
  ],
  "testPresets": [
    {
      "name": "headless",
      "configurePreset": "headless",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "sanitized",
      "configurePreset": "sanitized",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "realtime",
      "configurePreset": "realtime",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "bench",
      "configurePreset": "bench",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      },
      "filter": {
        "include": {
          "label": "bench"
        }
      }
    },
    {
      "name": "plugin",
      "configurePreset": "plugin",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      },
      "filter": {
        "include": {
          "label": "host"
        }
      }
    }
  ]
}
